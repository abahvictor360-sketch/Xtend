# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the scheduled jobs send (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=generate-a-long-random-string

# Naming the exact place at clock-in.
#
# Without a Google key the app falls back to OpenStreetMap, which knows
# Nigerian streets well but rarely names the shop. With one it returns
# "Justrite Superstore Bariga, 56/58 Jagun Molu St, Bariga, Lagos".
# Enable "Places API (New)" and "Geocoding API" on the Google Cloud project.
GOOGLE_MAPS_API_KEY=

# Cap on Google place requests per month (Lagos time). Once this month's
# requests reach it, OpenStreetMap is used until the next month. Left blank
# it is 20000; 0 or none turns the cap off. The Places page shows the use.
GOOGLE_MONTHLY_LOOKUP_LIMIT=

# Optional: Google's map (Map and Satellite) on Movement and Attendance.
# A SEPARATE key from the one above, because this one is visible in the
# browser: in Google Cloud restrict it to "Websites" (HTTP referrers) with
# your site's addresses, e.g. https://xtend.example.com/*, and to the
# "Maps JavaScript API" only. Without it, or whenever Google does not load,
# the maps show OpenStreetMap. A change needs a new deploy.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Contact header required by the Nominatim usage policy (the free fallback).
GEOCODER_USER_AGENT=Xtend/1.0 (ops@xpelbeauty.example)

# Web Push (admin notifications). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is shipped to the browser; the private key never leaves the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@xpelbeauty.ng

# "Ask Xtend" (admin dashboard): the attendance assistant that answers
# questions like "who hasn't clocked in today?". Get a key at
# console.anthropic.com. Without it the page shows a setup notice.
ANTHROPIC_API_KEY=
# Optional: the model Ask Xtend uses. The default is the most capable one
# (claude-opus-5). A cheaper model such as claude-sonnet-5-5 cuts the cost of
# every question a great deal and is enough for most lookups.
ASSISTANT_MODEL=

# Proxies in front of the app: 1 for Nginx/Caddy/Vercel, 2 with Cloudflare too.
TRUSTED_PROXY_HOPS=1
# Optional: ip-api.com key, for HTTPS IP lookups in the VPN check.
IP_API_KEY=
# Optional: another IP lookup address (instead of ip-api.com).
IP_GEO_URL=
# Optional: set 1 to switch IP lookups off.
IP_GEO_DISABLED=

# Android push: the Firebase service account JSON, on one line.
FIREBASE_SERVICE_ACCOUNT=
# iPhone push: the Apple push key (.p8 contents), its key id and team id.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# Optional: the iPhone app's bundle id, and 1 to use Apple's sandbox.
APNS_BUNDLE_ID=
APNS_SANDBOX=

# Optional: a relay that sends new staff their temporary password by SMS or email.
CREDENTIALS_WEBHOOK_URL=
CREDENTIALS_WEBHOOK_TOKEN=

# Phone app downloads and update prompts.
# iPhone: the App Store or TestFlight link and the newest build number.
IOS_APP_URL=
IOS_LATEST_BUILD=
# Optional: another APK address (e.g. Play Store) and its newest build number.
ANDROID_APK_URL=
ANDROID_LATEST_BUILD=
# Optional: the version shown on /download, and the repository whose
# "android" release holds the APK (owner/name).
APP_VERSION=
APP_RELEASE_REPO=

# Optional: the build id outside Vercel (deploy/deploy.sh sets it).
XTEND_BUILD_ID=
# Optional: set 1 to turn the browser's realtime connections off (polling only).
NEXT_PUBLIC_REALTIME_DISABLED=

# Optional: Cloudflare Turnstile "not a robot" check on sign-in. On only
# when both are set (Cloudflare → Turnstile → Add site, Managed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
