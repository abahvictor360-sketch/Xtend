# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Cron shared secret (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=generate-a-long-random-string

# Naming the exact place at clock-in.
#
# Without a Google key the app falls back to OpenStreetMap, which knows
# Nigerian streets well but rarely names the shop. With one it returns
# "Justrite Superstore Bariga, 56/58 Jagun Molu St, Bariga, Lagos".
# Enable "Places API (New)" and "Geocoding API" on the Google Cloud project.
GOOGLE_MAPS_API_KEY=

# Contact header required by the Nominatim usage policy (the free fallback).
GEOCODER_USER_AGENT=Xtend/1.0 (ops@xpelbeauty.example)

# Web Push (admin notifications). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is shipped to the browser; the private key never leaves the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@xpelbeauty.ng

# "Ask Xtend" (admin dashboard): the attendance assistant that answers
# questions like "who hasn't clocked in today?". Get a key at
# console.anthropic.com. Without it the page shows a setup notice.
ANTHROPIC_API_KEY=
