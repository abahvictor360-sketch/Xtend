# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Cron shared secret (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=generate-a-long-random-string

# Optional: reverse geocoding contact header required by Nominatim usage policy
GEOCODER_USER_AGENT=Xtend/1.0 (ops@xpelbeauty.example)

# Web Push (admin notifications). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is shipped to the browser; the private key never leaves the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@xpelbeauty.ng
